SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=student_feedback

# Required only for the first startup of a new database.
ADMIN_PASSWORD=choose-a-strong-admin-password

# Deployment platforms usually provide PORT automatically.
# Use HOST=0.0.0.0 in production so the platform can route traffic to the app.
HOST=0.0.0.0
PORT=8000
COOKIE_SECURE=1
